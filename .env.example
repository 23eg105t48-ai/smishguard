# ── SmishGuard Environment Variables ────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is git-ignored – never commit real secrets.

# Optional: Gemini API key for AI explanations
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: Google Safe Browsing API key for link scanning
# Get from: https://console.cloud.google.com/
SAFE_BROWSING_API_KEY=

# Production PostgreSQL database connection (not needed for local H2)
DATABASE_URL=
DB_USERNAME=
DB_PASSWORD=

# Comma-separated list of allowed frontend origins for CORS
# Example: https://smishguard.vercel.app,https://www.smishguard.app
ALLOWED_ORIGINS=http://localhost:5173

# Secret key for the admin /api/reports endpoint
ADMIN_KEY=change-me-to-a-strong-secret

# Frontend: backend URL (used by Vite build)
# For local dev this can be empty (proxy handles it)
VITE_API_URL=

# Spring profile: "local" (H2) or "prod" (PostgreSQL)
SPRING_PROFILES_ACTIVE=local
